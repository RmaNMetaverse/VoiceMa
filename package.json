{
  "name": "voicema",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted LAN voice chat (TeamSpeak/Mumble style) — WebRTC mesh audio + PWA client",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "cert": "node scripts/gen-cert.js",
    "icons": "node scripts/gen-icons.js",
    "setup": "node scripts/gen-cert.js && node scripts/gen-icons.js",
    "test": "node scripts/test-signaling.js",
    "dev": "node server/index.js --http"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "node-forge": "^1.3.1"
  }
}
